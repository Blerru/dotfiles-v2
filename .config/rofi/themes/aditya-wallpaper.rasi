/*****----- Configuration -----*****/

@import "themes/aditya.rasi"

window {
    transparency:                "real";
    location:                    south west;
    anchor:                      center;
    width:                       400px;
    height:                      300px;
    margin: 0px 0px 8px 8px;
}

mainbox {
    padding:                     8px 16px;
}

listview {
    spacing:                     5px;
}

element {
    enabled:                     true;
    spacing:                     0px;
    padding:                     2px 4px;
    spacing:                     12px;
}

